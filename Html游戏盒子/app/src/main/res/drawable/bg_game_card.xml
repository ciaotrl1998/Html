<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/border_active" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface_pressed" />
            <stroke android:width="2dp" android:color="@color/border_active" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/card_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
