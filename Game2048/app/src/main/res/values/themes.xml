<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HtmlGames" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/game_bg</item>
        <item name="android:statusBarColor">@color/board</item>
        <item name="android:navigationBarColor">@color/game_bg</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.HtmlGames.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/game_bg</item>
        <item name="android:statusBarColor">@color/game_bg</item>
        <item name="android:navigationBarColor">@color/game_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
